<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee" version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>gf</short-name>
    <uri>urn:glamoraa:fn</uri>
    <function>
        <name>money</name>
        <function-class>com.glamoraa.util.Fn</function-class>
        <function-signature>java.lang.String money(java.math.BigDecimal)</function-signature>
    </function>
    <function>
        <name>img</name>
        <function-class>com.glamoraa.util.Fn</function-class>
        <function-signature>java.lang.String img(java.lang.String)</function-signature>
    </function>
    <function>
        <name>initial</name>
        <function-class>com.glamoraa.util.Fn</function-class>
        <function-signature>java.lang.String initial(java.lang.String)</function-signature>
    </function>
    <function>
        <name>encode</name>
        <function-class>com.glamoraa.util.Fn</function-class>
        <function-signature>java.lang.String encode(java.lang.String)</function-signature>
    </function>
</taglib>
